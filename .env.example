# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELIMU PRO — Tanzanian Secondary School Management System Configuration
VITE_SCHOOL_ID="school_klm_01"
VITE_DEFAULT_LOCALE="en" # 'en' or 'sw'

# Tanzania Bulk SMS Gateway (Beem Africa / NextSMS / Simulator)
VITE_SMS_PROVIDER="SIMULATOR" # 'SIMULATOR' | 'BEEM_AFRICA' | 'NEXT_SMS'
VITE_SMS_SENDER_ID="ELIMU-PRO"
# Note: In production, configure private SMS keys in server backend proxy routes only:
BEEM_SMS_API_KEY=""
BEEM_SMS_SECRET_KEY=""

# Firebase Configuration (Optional Cloud deployment)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
